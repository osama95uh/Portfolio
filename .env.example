# ============================================================================
# SIAM Portfolio - Backend environment variables
# Copy these into your hosting provider (Vercel -> Project Settings ->
# Environment Variables) AND locally into .env.local, then fill in the values.
# The site runs fine with everything empty (backend degrades gracefully),
# but nothing is stored/tracked until these are set.
# ============================================================================

# --- Supabase (Project Settings -> API) --------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# IMPORTANT: use the service_role secret key (NEVER the anon key) -
# it must stay on the server only.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# --- Admin panel (https://your-site.com/admin) -------------------------------
# The login password for /admin. Choose a strong one.
ADMIN_PASSWORD=change-this-password

# --- Optional ---------------------------------------------------------------
# Public site URL, used for metadataBase / canonical / sitemap / robots.
# On Vercel it falls back to VERCEL_URL automatically, but set it once you
# have your final domain (e.g. https://siamkhan.sites) for correct SEO.
NEXT_PUBLIC_SITE_URL=

# GitHub personal access token: raises the API limit from 60 to 5000/hour.
# Create at https://github.com/settings/tokens (no scopes needed, repo read
# is enough).
GITHUB_TOKEN=
